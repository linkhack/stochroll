{
    "version": 1,
    "project": "stochroll",
    "project_url": "https://github.com/linkhack/stochroll",
    "repo": ".",
    "branches": [
        "prototype/event-masked-index-sampling"
    ],
    "benchmark_dir": "prototypes/stateful_simulation/benchmarks",
    "show_commit_url": "https://github.com/linkhack/stochroll/commit/",
    "env_dir": ".asv/env",
    "results_dir": ".asv/results-wp009",
    "html_dir": ".asv/html-wp009",
    "environment_type": "uv",
    "build_command": [
        "python -m pip wheel --no-deps -w {build_cache_dir} {build_dir}"
    ],
    "install_command": [
        "in-dir={env_dir} python -m pip install --no-deps --force-reinstall {wheel_file}"
    ],
    "uninstall_command": [
        "return-code=any python -m pip uninstall -y stochroll"
    ],
    "pythons": [
        "3.12"
    ],
    "matrix": {
        "req": {
            "numpy": [
                "2.5.1"
            ]
        },
        "env_nobuild": {
            "STOCHROLL_BENCH_CONFIG": [
                "wp009"
            ]
        }
    }
}
